#tp h3{margin:0 0 10px;font-size:13px}
.tr{margin-bottom:9px}.th{display:flex;justify-content:space-between}.th b{font-weight:700}
.tb{height:7px;border-radius:99px;background:var(--line);overflow:hidden;margin:3px 0}
.tb i{display:block;height:100%;background:var(--acc);border-radius:99px}
.tb.done i{background:var(--muted)}
.td{font-size:11px;color:var(--muted)}
body[data-theme=winter] h1::before{content:'❄️ ⛄ '}body[data-theme=winter] h1::after{content:' 🎄 ❄️'}
body[data-theme=halloween] h1::before{content:'🎃 🦇 '}body[data-theme=halloween] h1::after{content:' 👻 🎃'}
body[data-theme=bday] h1::before{content:'🎂 🎈 '}body[data-theme=bday] h1::after{content:' 🎁 🎉'}
body[data-theme=anniv] h1::before{content:'✨ 🥂 '}body[data-theme=anniv] h1::after{content:' 🎉 ✨'}
body[data-theme=fri13] h1::before{content:'🌑 🕸️ '}body[data-theme=fri13] h1::after{content:' 🕷️ 🌑'}
body[data-theme=black] h1::before{content:'🏷️ 💸 '}body[data-theme=black] h1::after{content:' 🛒 🏷️'}
