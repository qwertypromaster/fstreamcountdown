<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Сколько осталось до стрима?</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bungee&family=Pacifico&family=Creepster&display=swap" rel="stylesheet">
<style>
:root{box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
--bg:#15171c;--fg:#eceef2;--card:#1f2229;--line:#2b2f38;--muted:#9aa1ad;--acc:#6ea8fe;--fill:#6ea8fe;--num:#fff;--glow:none;--hf:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--bg)}
body{margin:0;min-height:100vh;color:var(--fg);background:var(--bg) fixed;font-family:system-ui,-apple-system,'Segoe UI',Roboto,sans-serif}
body[data-theme=winter]{--bg:radial-gradient(700px 320px at 15% 0,rgba(125,211,252,.55),transparent),radial-gradient(600px 320px at 90% 8%,rgba(196,181,253,.45),transparent),linear-gradient(180deg,#d8ecfb,#f5fbff);--fg:#15304a;--card:linear-gradient(160deg,rgba(255,255,255,.95),rgba(224,240,255,.8));--line:#bcd8ee;--muted:#55738f;--acc:#3b8fd9;--fill:linear-gradient(90deg,#7dd3fc,#3b8fd9,#a78bfa);--num:#12385f}
body[data-theme=halloween]{--bg:radial-gradient(420px 420px at 82% 8%,rgba(255,190,90,.55),transparent 65%),linear-gradient(180deg,#0f0618,#2a0f3d 55%,#5a1f0a);--fg:#ffe9d0;--card:linear-gradient(160deg,rgba(60,20,80,.85),rgba(30,10,40,.85));--line:#6b2f8f;--muted:#e0aa80;--acc:#ff7a18;--fill:linear-gradient(90deg,#ff7a18,#ffb347,#a855f7);--num:#ffa64d;--glow:0 0 14px rgba(255,122,24,.6);--hf:'Creepster',cursive}
body[data-theme=bday]{--bg:radial-gradient(500px 300px at 10% 5%,rgba(255,126,182,.5),transparent),radial-gradient(500px 300px at 95% 90%,rgba(62,207,142,.45),transparent),linear-gradient(135deg,#fff0f6,#eafff4);--fg:#3a2a33;--card:linear-gradient(160deg,#fff,#fff4f9);--line:#f6c6da;--muted:#7a5a68;--acc:#e0407f;--fill:linear-gradient(90deg,#ff7eb6,#ffd6e8,#3ecf8e);--num:#d63384}
body[data-theme=vice]{--bg:linear-gradient(#1a0b3d,#5b1a8f 45%,#ff3d9a 78%,#ffb347);--fg:#fff;--card:rgba(20,5,50,.6);--line:#00f0ff;--muted:#ffd0ee;--acc:#00f0ff;--fill:linear-gradient(90deg,#ff2d95,#ffb347,#00f0ff);--num:#fff;--glow:0 0 8px #ff2d95,0 0 22px #ff2d95;--hf:'Bungee',sans-serif}
body[data-theme=doom]{--bg:radial-gradient(600px 400px at 50% 0,rgba(120,0,0,.45),transparent),#050000;--fg:#c40000;--card:linear-gradient(160deg,#160000,#080000);--line:#4a0000;--muted:#8a0000;--acc:#e00000;--fill:linear-gradient(90deg,#500000,#e00000);--num:#ff1a1a;--glow:0 0 12px #f00;--hf:'Creepster',cursive}
body[data-theme=april]{--bg:conic-gradient(from 20deg at 30% 30%,#ffe14d,#a56bff,#43e6a0,#ff6b9a,#ffe14d);--fg:#8e7a2a;--card:rgba(255,235,120,.35);--line:rgba(120,90,200,.25);--muted:#a08a3a;--acc:#a56bff;--fill:linear-gradient(90deg,#ffe14d,#a56bff);--num:#9c8420}
body[data-theme=anniv]{--bg:radial-gradient(600px 400px at 50% 0,rgba(255,215,0,.35),transparent),linear-gradient(160deg,#12063a,#3b1470 55%,#7a2d8f);--fg:#fff3d6;--card:linear-gradient(160deg,rgba(255,215,120,.16),rgba(255,255,255,.05));--line:rgba(255,215,120,.45);--muted:#f0d9a0;--acc:#ffd166;--fill:linear-gradient(90deg,#ffb703,#ffe08a,#f472b6);--num:#ffe08a;--glow:0 0 14px rgba(255,200,80,.6)}
body[data-theme=fri13]{--bg:radial-gradient(500px 300px at 50% 0,rgba(180,220,200,.25),transparent),linear-gradient(180deg,#070c0d,#132022 60%,#0a1112);--fg:#c5d8d2;--card:linear-gradient(160deg,rgba(30,50,50,.85),rgba(10,20,20,.85));--line:#2f4a48;--muted:#7f9c96;--acc:#7fd1b9;--fill:linear-gradient(90deg,#1f4d47,#7fd1b9);--num:#dff5ee;--glow:0 0 12px rgba(127,209,185,.45);--hf:'Creepster',cursive}
body[data-theme=black]{--bg:repeating-linear-gradient(-45deg,#000 0 26px,#141100 26px 52px);--fg:#fff;--card:linear-gradient(160deg,#1a1a1a,#000);--line:#ffd400;--muted:#d9c25a;--acc:#ffd400;--fill:repeating-linear-gradient(-45deg,#ffd400 0 14px,#111 14px 28px);--num:#ffd400;--hf:'Bungee',sans-serif}
body[data-theme=blood]{--bg:#0a0000;--fg:#ffd0d0;--card:rgba(20,0,0,.6);--line:#7a0000;--muted:#ff8a8a;--acc:#ff2020;--fill:linear-gradient(90deg,#500000,#ff0000);--num:#fff;--glow:0 0 14px #f00;--hf:'Creepster',cursive}
body[data-theme=end]{--bg:radial-gradient(700px 500px at 50% 45%,rgba(255,255,255,.55),transparent),linear-gradient(160deg,#ffd9ea,#ff9fcd 55%,#ff70b3);--fg:#5a1236;--card:rgba(255,255,255,.55);--line:rgba(255,255,255,.85);--muted:#8a2a5c;--acc:#ff4fa3;--fill:#ff4fa3;--num:#7a0f45;--glow:none;--hf:'Pacifico',cursive}
main{position:relative;z-index:3;max-width:960px;margin:0 auto;padding:56px 18px 70px;display:flex;flex-direction:column;align-items:center;gap:28px}
.head{text-align:center}
h1{font-family:var(--hf);font-size:clamp(26px,5.5vw,50px);font-weight:700;line-height:1.15;margin:0 0 8px;color:var(--num);text-shadow:var(--glow)}
body[data-theme=doom] h1{animation:flick 3s infinite;letter-spacing:.06em}
@keyframes flick{0%,90%,100%{opacity:1}92%{opacity:.3}94%{opacity:1}96%{opacity:.5}}
.sub{margin:0;color:var(--muted);font-size:17px}
body[data-theme=vice] .sub{font-family:'Pacifico',cursive;font-size:24px;color:#fff;text-shadow:0 0 10px #00f0ff}
.clock{margin-top:10px;color:var(--muted);font-size:14px;font-variant-numeric:tabular-nums}
.big{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:10px;width:100%}
.unit,.bar-wrap,.tot div{background:var(--card);border:1px solid var(--line);border-radius:14px}
.unit{text-align:center;padding:16px 8px 12px}
.unit b{display:block;font-size:clamp(28px,4.5vw,40px);font-weight:700;font-variant-numeric:tabular-nums;color:var(--num);text-shadow:var(--glow)}
.unit span{font-size:13px;color:var(--muted)}
.bar-wrap{width:100%;padding:20px}
.bar{height:22px;border-radius:999px;background:var(--line);overflow:hidden}
.fill{height:100%;width:0;min-width:10px;border-radius:999px;background:var(--fill)}
.pct{text-align:center;font-size:24px;font-weight:700;margin-top:12px;font-variant-numeric:tabular-nums;color:var(--num);text-shadow:var(--glow)}
.meta{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);margin-top:8px;gap:10px;flex-wrap:wrap}
h2{font-size:15px;margin:4px 0 0;color:var(--muted);font-weight:600}
.tot{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;width:100%}
.tot div{padding:12px 16px}
.tot b{display:block;font-size:20px;font-variant-numeric:tabular-nums;word-break:break-all;color:var(--num)}
.tot span{font-size:13px;color:var(--muted)}
body[data-theme=april] main{filter:blur(1.4px)}
body[data-theme=april] .head,body[data-theme=april] .unit,body[data-theme=april] .tot div{transform:rotate(-1.4deg)}
body[data-theme=april] .unit:nth-child(2n),body[data-theme=april] .tot div:nth-child(2n){transform:rotate(1.6deg) scaleX(-1)}
#blood,#vig,#fin{display:none;position:fixed}
body[data-theme=blood] #blood,body[data-theme=blood] #vig{display:block}
body[data-theme=blood] #fin{display:flex}
body[data-theme=blood] main{z-index:6}
#blood{top:0;left:0;width:100%;height:0;z-index:4;pointer-events:none;background:linear-gradient(#3a0000,#8b0000 50%,#d00000);box-shadow:0 0 60px #f00;animation:flick 2.3s infinite}
#blood::after{content:'';position:absolute;top:100%;left:0;width:100%;height:64px;background:radial-gradient(ellipse 10px 44px at 50% 0,#9b0000 92%,transparent) 0 0/97px 64px repeat-x,radial-gradient(ellipse 7px 28px at 50% 0,#c40000 92%,transparent) 30px 0/131px 64px repeat-x,radial-gradient(ellipse 12px 56px at 50% 0,#7a0000 92%,transparent) 70px 0/173px 64px repeat-x}
#vig{inset:0;z-index:5;pointer-events:none;background:radial-gradient(circle,transparent 35%,rgba(140,0,0,.85));animation:beat 1s infinite}
@keyframes beat{0%,100%{opacity:.35}15%{opacity:1}30%{opacity:.5}45%{opacity:1}}
#fin{inset:0;z-index:12;background:#000;opacity:0;align-items:center;justify-content:center;pointer-events:none}
#fin span{font-family:'Creepster',cursive;font-size:clamp(44px,12vw,140px);color:#d00000;text-shadow:0 0 30px #f00;opacity:0;transition:opacity .3s;letter-spacing:.08em;text-align:center}
body[data-theme=blood] .f{z-index:5}
#ecl,#flash{display:none;position:fixed;pointer-events:none}
body[data-theme=blood] #ecl,body[data-theme=blood] #flash{display:block}
#ecl{left:50%;top:50%;width:min(78vmin,620px);aspect-ratio:1;z-index:5;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,#000 56%,#ff3b00 58%,rgba(255,0,0,.55) 64%,rgba(120,0,0,.25) 72%,transparent 78%);animation:ecl 1.2s infinite}
@keyframes ecl{0%,100%{transform:translate(-50%,-50%) scale(1)}15%,45%{transform:translate(-50%,-50%) scale(1.07)}30%{transform:translate(-50%,-50%) scale(1.02)}}
#flash{inset:0;z-index:11;background:#f00;opacity:0}
body[data-theme=blood] h1{animation:glitch 1.6s infinite;letter-spacing:.05em}
@keyframes glitch{0%,88%,100%{text-shadow:0 0 14px #f00;transform:none}90%{text-shadow:-4px 0 #0ff,4px 0 #f00;transform:skewX(-8deg)}94%{text-shadow:4px 0 #0ff,-4px 0 #f00;transform:skewX(6deg) translateX(6px)}}
body[data-theme=blood] .unit,body[data-theme=blood] .bar-wrap,body[data-theme=blood] .tot div{border-color:#c40000;box-shadow:0 0 20px rgba(255,0,0,.45),inset 0 0 20px rgba(120,0,0,.5)}
body[data-theme=blood] .fill{box-shadow:0 0 22px #f00}
body::before,body::after{content:'';position:fixed;left:0;right:0;pointer-events:none;z-index:1;display:none}
body[data-theme=winter]::before{display:block;bottom:0;height:110px;background:radial-gradient(ellipse 45% 100% at 15% 100%,#fff 62%,transparent 63%),radial-gradient(ellipse 55% 100% at 60% 100%,#eef7ff 62%,transparent 63%),radial-gradient(ellipse 40% 100% at 100% 100%,#fff 62%,transparent 63%)}
body[data-theme=winter] .unit,body[data-theme=winter] .bar-wrap{box-shadow:0 8px 30px rgba(59,143,217,.22)}
body[data-theme=halloween]::before{display:block;bottom:0;height:200px;background:radial-gradient(ellipse 60% 100% at 30% 100%,rgba(168,85,247,.4),transparent),radial-gradient(ellipse 50% 100% at 80% 100%,rgba(255,122,24,.35),transparent)}
body[data-theme=halloween] .unit,body[data-theme=halloween] .bar-wrap,body[data-theme=halloween] .tot div{box-shadow:0 0 18px rgba(255,122,24,.28)}
body[data-theme=bday]::before{display:block;top:0;bottom:0;opacity:.4;background-image:radial-gradient(#ff7eb6 3px,transparent 4px),radial-gradient(#3ecf8e 3px,transparent 4px),radial-gradient(#ffd166 2.5px,transparent 3.5px);background-size:90px 90px,130px 130px,70px 70px;background-position:0 0,40px 60px,20px 30px}
body[data-theme=anniv]::before{display:block;top:0;bottom:0;opacity:.55;background-image:radial-gradient(#ffd166 1.5px,transparent 2px),radial-gradient(#fff 1px,transparent 1.5px);background-size:110px 110px,70px 70px;background-position:0 0,35px 45px}
body[data-theme=anniv] .unit,body[data-theme=anniv] .bar-wrap{border-color:rgba(255,215,120,.6);box-shadow:0 0 22px rgba(255,200,80,.25)}
body[data-theme=fri13]::before{display:block;top:0;bottom:0;background:radial-gradient(circle at 82% 12%,rgba(235,250,244,.9) 0 34px,rgba(180,230,210,.25) 36px,transparent 90px),linear-gradient(transparent 70%,rgba(180,220,205,.18))}
body[data-theme=black]::before{display:block;top:0;height:16px;background:repeating-linear-gradient(-45deg,#ffd400 0 14px,#000 14px 28px)}
body[data-theme=black]::after{display:block;bottom:0;height:16px;background:repeating-linear-gradient(-45deg,#ffd400 0 14px,#000 14px 28px)}
body[data-theme=doom]::before{display:block;top:0;bottom:0;background:radial-gradient(circle at 50% 120%,rgba(170,0,0,.5),transparent 60%),radial-gradient(circle,transparent 45%,rgba(0,0,0,.85))}
body[data-theme=vice] .unit,body[data-theme=vice] .bar-wrap{border-color:#00f0ff;box-shadow:0 0 18px rgba(0,240,255,.45),inset 0 0 14px rgba(255,45,149,.25)}
.gone{animation:crumble 1.4s ease-in forwards;pointer-events:none}
@keyframes crumble{0%{transform:none;opacity:1}15%{transform:translate(4px,2px) rotate(2deg)}30%{transform:translate(-5px,3px) rotate(-3deg);filter:contrast(2)}100%{transform:translateY(60vh) rotate(25deg);opacity:0;filter:blur(4px)}}
body[data-theme=blood] .gone{display:none}
body[data-theme=blood] main{min-height:100vh;justify-content:center}
#msg{display:none;position:fixed;left:0;right:0;bottom:9vh;z-index:7;text-align:center;font-family:'Creepster',cursive;font-size:clamp(22px,5vw,48px);color:#ff2a00;text-shadow:0 0 18px #f00;letter-spacing:.06em;pointer-events:none;padding:0 12px}
body[data-theme=blood] #msg{display:block}
body[data-theme=end] .sub,body[data-theme=end] .clock,body[data-theme=end] .bar-wrap,body[data-theme=end] h2,body[data-theme=end] .tot{display:none}
body[data-theme=end] .gone{animation:none;opacity:1;filter:none;transform:none}
body[data-theme=end] main{min-height:100vh;justify-content:center}
body[data-theme=end] .head{position:fixed;top:9vh;left:0;right:0;padding:0 14px}
body[data-theme=end] h1{font-size:clamp(34px,8vw,84px);font-weight:400}
body[data-theme=end] .unit{box-shadow:0 10px 40px rgba(255,79,163,.35);backdrop-filter:blur(6px)}
#endbot{display:none;position:fixed;left:0;right:0;bottom:calc(14px + env(safe-area-inset-bottom,0px));z-index:7;text-align:center;font-size:13px;letter-spacing:.04em;color:var(--muted);pointer-events:none}
body[data-theme=end] #endbot{display:block}
#lock{position:fixed;top:calc(62px + env(safe-area-inset-top,0px));right:12px;z-index:20;width:min(280px,calc(100vw - 24px));padding:16px;border-radius:14px;background:var(--card);color:var(--fg);border:1px solid var(--line);display:none;font-size:14px;font-family:system-ui,sans-serif;text-shadow:none}
#lock.open{display:block}
#lock input{width:100%;margin-top:10px;padding:8px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--fg);font:inherit}
#lock button{margin-top:8px;padding:8px 12px;border-radius:8px;border:0;background:var(--acc);color:#000;font-weight:700;cursor:pointer}
#cerr{color:#f66;font-size:12px;min-height:14px;margin-top:6px}
#gear2{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));left:12px;z-index:20;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:20px;cursor:pointer}
#tp{position:fixed;top:calc(62px + env(safe-area-inset-top,0px));left:12px;z-index:20;width:min(360px,calc(100vw - 24px));max-height:80vh;overflow:auto;padding:12px;border-radius:14px;background:var(--card);color:var(--fg);border:1px solid var(--line);display:none;font:12px system-ui,sans-serif;text-shadow:none}
