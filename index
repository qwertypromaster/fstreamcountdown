body[data-theme=halloween] .facts h3::before{content:'🎃 '}body[data-theme=halloween] .facts h3::after{content:' 🎃'}body[data-theme=halloween] .facts li::before{content:'🦇'}
body[data-theme=bday] .facts h3::before{content:'🎂 '}body[data-theme=bday] .facts h3::after{content:' 🎉'}body[data-theme=bday] .facts li::before{content:'🎈'}
body[data-theme=anniv] .facts h3::before{content:'✨ '}body[data-theme=anniv] .facts h3::after{content:' ✨'}body[data-theme=anniv] .facts li::before{content:'✨'}
body[data-theme=fri13] .facts h3::before{content:'🕸️ '}body[data-theme=fri13] .facts h3::after{content:' 🕷️'}body[data-theme=fri13] .facts li::before{content:'🕸️'}
body[data-theme=black] .facts h3::before{content:'🏷️ '}body[data-theme=black] .facts h3::after{content:' 🛒'}body[data-theme=black] .facts li::before{content:'🏷️'}
