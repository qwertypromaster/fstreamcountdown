#openG,.gb{padding:10px 16px;border-radius:10px;border:0;background:var(--acc);color:#000;font:700 14px system-ui,sans-serif;cursor:pointer}
.gb{display:block;width:100%;margin:8px 0;text-align:left}
#gm{display:none;position:fixed;inset:0;z-index:30;background:rgba(0,0,0,.6);align-items:center;justify-content:center}
#gm.open{display:flex}
.gbox{width:min(360px,94vw);max-height:92vh;overflow:auto;padding:14px;border-radius:14px;background:var(--card);border:1px solid var(--line);color:var(--fg);font-family:system-ui,sans-serif;backdrop-filter:blur(14px);text-shadow:none}
.gtop{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
#gx{border:0;background:transparent;color:var(--fg);font-size:20px;cursor:pointer}
.gmsg{text-align:center;margin:10px 0;font-size:15px}#sT{font-size:36px;font-weight:800;font-variant-numeric:tabular-nums}
.mg{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.mc{aspect-ratio:1;font-size:28px;border-radius:10px;border:1px solid var(--line);background:rgba(127,127,127,.25);color:var(--fg);cursor:pointer}
.mc[data-ok]{background:var(--acc)}
@keyframes hud{50%{box-shadow:0 0 26px rgba(125,255,180,.4),inset 0 0 30px rgba(0,0,0,.6)}}
#advBtn{display:none;margin:14px auto 0;padding:8px 14px;border-radius:8px;border:1px solid #7dffb4;background:rgba(0,0,0,.4);color:#7dffb4;font:700 12px 'Courier New',monospace;letter-spacing:.18em;cursor:pointer;text-shadow:0 0 8px #22ff88;animation:hud 2.4s ease-in-out infinite}
#advBtn.gone{animation:crumble 1.4s ease-in forwards}
body.advok #advBtn{display:block}
body[data-theme=end] #advBtn,body[data-theme=blood] #advBtn{display:none!important}
body.adv .bar{display:none}
#zwrap{display:none;position:relative;padding:12px;border-radius:10px;border:1px solid rgba(125,255,180,.4);background:linear-gradient(180deg,rgba(0,12,6,.85),rgba(0,0,0,.6));font-family:'Courier New',monospace;color:#7dffb4;box-shadow:0 0 18px rgba(125,255,180,.18),inset 0 0 30px rgba(0,0,0,.6);animation:hud 3s ease-in-out infinite}
body.adv #zwrap{display:block}
#zwrap::before,#zwrap::after{content:'';position:absolute;width:16px;height:16px;border:2px solid #7dffb4}
#zwrap::before{top:-2px;left:-2px;border-right:0;border-bottom:0}#zwrap::after{bottom:-2px;right:-2px;border-left:0;border-top:0}
#zc{display:block;width:100%;height:70px;border-radius:6px;background:repeating-linear-gradient(0deg,rgba(125,255,180,.06) 0 1px,transparent 1px 3px),#03100a}
.zctl{display:flex;gap:8px;align-items:center;margin-top:10px}.zctl input{flex:1;accent-color:#7dffb4}
.zctl button{width:30px;height:28px;border-radius:6px;border:1px solid #7dffb4;background:transparent;color:#7dffb4;font:700 16px monospace;cursor:pointer}
#zl{font:12px monospace;min-width:90px;text-align:right}
#zs{font-size:12px;margin-top:8px;line-height:1.6;white-space:pre-wrap;word-break:break-all}
body.adv .pct{font-family:'Courier New',monospace;font-size:clamp(13px,2.7vw,22px);color:#7dffb4;text-shadow:0 0 10px #22ff88;word-break:break-all}
/* menu */
#gear{position:fixed;top:calc(12px + env(safe-area-inset-top,0px));right:12px;z-index:20;width:42px;height:42px;border-radius:50%;border:1px solid var(--line);background:var(--card);color:var(--fg);font-size:20px;cursor:pointer}
#menu{position:fixed;top:calc(62px + env(safe-area-inset-top,0px));right:12px;z-index:20;width:min(330px,calc(100vw - 24px));max-height:80vh;overflow:auto;padding:16px;border-radius:14px;background:var(--card);color:var(--fg);border:1px solid var(--line);display:none;font-size:14px;font-family:system-ui,sans-serif;text-shadow:none}
#menu.open{display:block}
#menu h3{margin:14px 0 6px;font-size:14px}#menu h3:first-child{margin-top:0}
#menu input,#menu select{width:100%;padding:7px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--fg);font:inherit}
.dur{display:grid;grid-template-columns:repeat(3,1fr);gap:6px}.dur label{font-size:12px;color:var(--muted)}
#menu button{margin-top:8px;padding:8px 12px;border-radius:8px;border:0;background:var(--acc);color:#000;font-weight:700;cursor:pointer}
#menu button.g{background:transparent;color:var(--fg);border:1px solid var(--line);margin-left:6px}
#menu .pv{font-size:12px;color:var(--muted);margin-top:6px}
#err{color:#f66;font-size:12px;min-height:14px;margin-top:6px}
/* falling */
.f{position:fixed;top:-10vh;z-index:2;pointer-events:none;animation:fall linear infinite}
@keyframes fall{to{transform:translateY(118vh) rotate(360deg)}}
/* vice city */
.vc{display:none;position:fixed;inset:0;z-index:1;overflow:hidden;pointer-events:none}
body[data-theme=vice] .vc{display:block}
body[data-theme=vice] main{padding-top:80px}
.sun{position:absolute;left:50%;bottom:26%;width:min(420px,70vw);aspect-ratio:1;transform:translateX(-50%);border-radius:50%;background:linear-gradient(#ffe36e,#ff3d9a);-webkit-mask-image:repeating-linear-gradient(#000 0 20px,transparent 20px 25px);mask-image:repeating-linear-gradient(#000 0 20px,transparent 20px 25px);opacity:.85;box-shadow:0 0 90px #ff3d9a}
.floor{position:absolute;left:-50%;right:-50%;bottom:0;height:28%;background:linear-gradient(#2a0a55,#0d0225);transform:perspective(260px) rotateX(58deg);transform-origin:bottom;background-image:repeating-linear-gradient(90deg,#00f0ff 0 2px,transparent 2px 70px),repeating-linear-gradient(0deg,#00f0ff 0 2px,transparent 2px 44px)}
.palm{position:absolute;bottom:6%;font-size:clamp(110px,22vw,230px);line-height:1;filter:brightness(0) drop-shadow(0 0 10px #ff2d95)}
.p1{left:-2%}.p2{right:-2%;transform:scaleX(-1)}
.marq{position:absolute;top:0;left:0;width:100%;background:#ff2d95;color:#fff;font-family:'Bungee',sans-serif;font-size:20px;padding:8px 0;overflow:hidden;white-space:nowrap;box-shadow:0 0 25px #ff2d95}
.marq div{display:inline-block;animation:mq 14s linear infinite}
@keyframes mq{to{transform:translateX(-50%)}}
</style>
</head>
<body>
<div class="vc"><div class="sun"></div><div class="floor"></div><div class="palm p1">🌴</div><div class="palm p2">🌴</div><div class="marq"><div id="mq"></div></div></div>
<button id="gear" aria-label="Меню">⚙</button>
<button id="gear2" aria-label="Темы">☰</button>
<div id="tp"></div>
<div id="gm"><div class="gbox"><div class="gtop"><b id="gtitle">Меню игр</b><button id="gx">✕</button></div><div id="gbody"></div></div></div>
<div id="lock"><b>Секретный код</b><input type="password" id="code" placeholder="Введите код" autocomplete="off"><button id="unlock">Войти</button><div id="cerr"></div></div>
<div id="ecl"></div><div id="vig"></div><div id="blood"></div><div id="flash"></div><div id="msg"></div><div id="endbot">привет из 29 сентября 2026</div><div id="fin"><span>ПРИШЛО ВРЕМЯ</span></div>
<div id="menu">
  <h3>Поставить свою дату и время</h3>
  <input type="datetime-local" id="dt">
  <button id="setDate">Применить</button><div class="pv" id="pv1">—</div>
  <h3>Поставить, сколько должно оставаться</h3>
  <div class="dur">
    <div><label>лет</label><input type="number" min="0" id="d0" value="0"></div>
    <div><label>месяцев</label><input type="number" min="0" id="d1" value="0"></div>
    <div><label>дней</label><input type="number" min="0" id="d2" value="0"></div>
    <div><label>часов</label><input type="number" min="0" id="d3" value="0"></div>
    <div><label>минут</label><input type="number" min="0" id="d4" value="0"></div>
    <div><label>секунд</label><input type="number" min="0" id="d5" value="0"></div>
  </div>
  <button id="setDur">Применить</button><div class="pv" id="pv2">—</div>
  <h3>Тема</h3>
  <select id="theme"><option value="auto">Автоматически по дате</option><option value="default">Обычная</option><option value="april">🤡 1 апреля</option><option value="bday">🎂 День рождения</option><option value="anniv">🥂 Годовщина</option><option value="halloween">🎃 Хэллоуин</option><option value="black">🏷️ Чёрная пятница</option><option value="winter">❄️ Новый год</option><option value="fri13">🕸️ Пятница 13</option><option value="vice">🌴 Vice City (ГТА 6)</option><option value="doom">2031.</option></select>
  <div id="err"></div>
  <h3>Секретное</h3><button id="advAdm">Расширенный режим</button>
  <button class="g" id="reset" style="margin-left:0">Сбросить всё</button>
</div>
<main id="main">
  <div class="head"><h1 id="title"></h1><p class="sub" id="sub"></p><div class="clock" id="clock"></div></div>
  <div class="big" id="big"></div>
  <div class="bar-wrap">
    <div class="bar"><div class="fill" id="fill"></div></div>
    <div id="zwrap"><canvas id="zc"></canvas><div class="zctl"><button id="zm">−</button><input type="range" id="zr" min="0" max="9" step="0.01" value="0"><button id="zp">+</button><span id="zl">×1</span></div><div id="zs"></div></div>
    <div class="pct" id="pct"></div>
    <div class="meta"><span id="mS"></span><span id="mE"></span></div>
    <button id="advBtn">РАСШИРЕННЫЙ РЕЖИМ</button>
  </div>
  <h2 id="h2"></h2>
  <div class="tot" id="tot"></div>
  <section class="facts" id="facts"></section>
  <section class="facts" id="games"><h3>Мини-игры</h3><p style="margin:0 0 12px;font-size:14px;color:var(--muted)">Пока ждёшь стрим, можно сыграть. Если тема сменится посреди игры, она вылетит.</p><button id="openG">🎮 Меню игр</button></section>
</main>
<script>
const $=id=>document.getElementById(id);
const DEF={start:new Date(2026,7,15).getTime(),end:new Date(2031,7,15).getTime()};
let cfg={off:0,theme:'auto'};
try{const c=JSON.parse(localStorage.getItem('cfg3')||'null');if(c&&isFinite(c.off))cfg=Object.assign(cfg,c)}catch(e){}
const save=()=>{try{localStorage.setItem('cfg3',JSON.stringify(cfg))}catch(e){}};
const TX={
 default:['Сколько осталось до стрима?','','Всего осталось'],
 winter:['С Новым годом! До стрима осталось','Пусть в новом году всё сбудется','Всего до стрима'],
 halloween:['Хэллоуин: до стрима осталось…','Если доживёшь','Всего мрачных мгновений'],
 bday:['С днём рождения!','А до стрима осталось:','Всего до стрима'],
 vice:['ГТА 6 СЕГОДНЯ!!!','Welcome to Vice City! Мега радость!!!','Всего до стрима'],
 doom:['ОСТАЛОСЬ ДО ВАШЕЙ СУДЬБЫ','Время утекает…','ВСЕГО ОСТАЛОСЬ'],
 april:['…','…','…'],anniv:['…','…','Всего до стрима'],
 fri13:['Пятница, 13-е: до стрима осталось…','Не выходи из дома сегодня','Всего осталось'],
 black:['ЧЁРНАЯ ПЯТНИЦА','Скидка на время: до стрима осталось','Всего до стрима'],
 blood:['…','…','ВСЕГО ОСТАЛОСЬ'],end:['Вот и все..','…','…']};
const FALL={winter:['\u2744\uFE0E','\u2745\uFE0E','\u2746\uFE0E'],halloween:['🎃','🦇','👻'],bday:['🎁','🎀','🎉'],vice:['🌴','🚗','💖','🔥','🕶️'],anniv:['✨','🎉','⭐','🎂'],fri13:['🕸️','🕷️'],black:['🏷️','💸','🛒','🔥'],blood:['●','•','▪']};
function auto(n){const y=n.getFullYear(),m=n.getMonth()+1,d=n.getDate(),k=(m*100+d)*100+n.getHours();
 if(n>=new Date(2031,0,1))return'doom';
 if(y==2026&&m==11&&d==19)return'vice';
 if(m==4&&d==1)return'april';
 if(m==4&&d==28)return'bday';
 if(m==8&&d==15)return'anniv';
 if(k>=102500&&k<110100)return'halloween';
 if(d==13&&n.getDay()==5)return'fri13';
 if(m==11){const f=1+(4-new Date(y,10,1).getDay()+7)%7;if(d==f+22)return'black'}
 if(k>=120100||k<=11512)return'winter';
 return'default'}
const T=(e,t)=>{if(e._t!==t){e.textContent=t;e._t=t}};let cur='';
function setTheme(t){if(t===cur)return;cur=t;lastSec=-1;quitGame('Игра вылетела: тема сменилась');advSet(0);document.body.dataset.theme=t;
 const x=TX[t];T($('title'),x[0]);T($('sub'),x[1]);$('sub').style.display=x[1]?'':'none';T($('h2'),x[2]);
 $('mq').textContent=('ГТА 6 СЕГОДНЯ!!! ★ VICE CITY ★ '.repeat(8));
 document.querySelectorAll('.f').forEach(e=>e.remove());
 const a=FALL[t];if(a){for(let i=0;i<26;i++){const e=document.createElement('span');e.className='f';e.textContent=a[i%a.length];
  e.style.cssText=`left:${Math.random()*100}vw;font-size:${(t==='blood'?5:16)+Math.random()*(t==='blood'?9:22)}px;animation-duration:${6+Math.random()*8}s;animation-delay:-${Math.random()*12}s;color:${t==='winter'?'#7fb4e6':t==='blood'?'#c40000':'inherit'}`;document.body.appendChild(e)}}}
const pl=(n,f)=>{n=Math.abs(n);const a=n%100,b=n%10;return a>10&&a<15?f[2]:b==1?f[0]:b>1&&b<5?f[1]:f[2]};
const U=[['год','года','лет'],['месяц','месяца','месяцев'],['день','дня','дней'],['час','часа','часов'],['минута','минуты','минут'],['секунда','секунды','секунд'],['миллисекунда','миллисекунды','миллисекунд']];
const addM=(d,k)=>{const r=new Date(d.getFullYear(),d.getMonth()+k,1,d.getHours(),d.getMinutes(),d.getSeconds(),d.getMilliseconds());const l=new Date(r.getFullYear(),r.getMonth()+1,0).getDate();r.setDate(Math.min(d.getDate(),l));return r};
function parts(a,b){let mo=(b.getFullYear()-a.getFullYear())*12+b.getMonth()-a.getMonth();while(mo>0&&addM(a,mo)>b)mo--;
 let r=b-addM(a,mo);const d=Math.floor(r/864e5);r-=d*864e5;const h=Math.floor(r/36e5);r-=h*36e5;const m=Math.floor(r/6e4);r-=m*6e4;const s=Math.floor(r/1e3);r-=s*1e3;
 return[Math.floor(mo/12),mo%12,d,h,m,s,r]}
const fmt=(n,d=0)=>n.toLocaleString('ru-RU',{minimumFractionDigits:d,maximumFractionDigits:d});
const ds=t=>new Date(t).toLocaleString('ru-RU',{dateStyle:'long',timeStyle:'short'});
const bigEls=U.map(()=>{const e=document.createElement('div');e.className='unit';e.innerHTML='<b></b><span></span>';$('big').appendChild(e);return e});
const totEls=U.map(()=>{const e=document.createElement('div');e.innerHTML='<b></b><span></span>';$('tot').appendChild(e);return e});
const YMS=365.2425*864e5,DV=[YMS,YMS/12,864e5,36e5,6e4,1e3,1];
const SC='абвгдежзиклмнопрстуфхцчшщыэюяЖЩЪ#%&?@0123456789';
const mess=x=>[...x].map(c=>c===' '?c:Math.random()<.65?SC[Math.random()*SC.length|0]:c).join('');
const ED=new Date(DEF.end).toLocaleDateString('ru-RU',{day:'numeric',month:'long',year:'numeric'}).replace(' г.','').toUpperCase();
const HORR=[ED+' — ЭТО КОНЕЦ','ПРОЩАЙ','НАСТУПАЕТ '+ED,'ВСЁ ЗАКАНЧИВАЕТСЯ','ПОСЛЕДНИЕ СЕКУНДЫ','ПРОЩАЙ…'];
const DEC=[...totEls.map((e,i)=>[e,290-i*15]),[$('h2'),185],[$('clock'),165],[$('sub'),145],[document.querySelector('.meta'),125],[$('title'),100],[$('facts'),298],[$('games'),299],[$('advBtn'),300]];
let lastTp=-1,lastSec=-1,rnd=null,lab=[],mT=0,fl=0;
function tick(){
 try{
  const now=new Date(Date.now()+cfg.off),left=Math.max(0,DEF.end-now),th=now>=DEF.end+60000?'end':left<=60000?'blood':cfg.theme==='auto'?auto(now):cfg.theme;
  setTheme(th);const sec=now.getSeconds(),ap=th==='april';
  if($('tp').classList.contains('open')&&sec!==lastTp){lastTp=sec;renderTP(now)}
  if(ap){if(sec!==lastSec||!rnd){lastSec=sec;const r=m=>Math.random()*(m+1)|0;
   rnd={p:[r(99),r(11),r(30),r(23),r(59),r(59),r(999)],t:DV.map((_,i)=>fmt(Math.random()*[99,1200,36500,876000,5e7,3e9,1e12][i],i<3?2:0)),pct:Math.random()*100};
   lab=U.map(u=>mess(u[2]));T($('title'),mess('Сколько осталось до стрима?'));T($('sub'),mess('Первое апреля'));T($('h2'),mess('Всего осталось'));T($('clock'),mess((cfg.off?'Дата на сайте: ':'Ваше время: ')+now.toLocaleString('ru-RU')))}}
  else T($('clock'),(cfg.off?'Дата на сайте: ':'Ваше время: ')+now.toLocaleString('ru-RU'));
  if(th==='anniv'){const y=Math.round(left/YMS),n=now.getFullYear()-2026;T($('title'),'Годовщина! Осталось '+y+' '+pl(y,U[0]));T($('sub'),n>0?n+' '+pl(n,U[0])+' назад всё началось':'Сегодня всё началось')}
  if(th==='blood'){const f=1-left/6e4;T($('msg'),HORR[(sec/4|0)%HORR.length]);
   $('blood').style.height=(f*104)+'%';$('vig').style.animationDuration=(1.1-.85*f)+'s';
   const k=f*f*18;$('main').style.transform='translate('+(Math.random()-.5)*k+'px,'+(Math.random()-.5)*k+'px)';mT=1;
   $('fin').style.opacity=left<=1e3?1-left/1e3:0;$('fin').firstChild.style.opacity=left<=400?1:0;fl=Math.max(0,fl-.03);if(Math.random()<.015)fl=.25+.4*f;$('flash').style.opacity=fl;$('ecl').style.opacity=.2+.8*f}
  else if(left<=3e5&&th!=='end'){const q=1-left/3e5,k=q*q*7;$('main').style.transform='translate('+(Math.random()-.5)*k+'px,'+(Math.random()-.5)*k+'px)';mT=1}
  else if(mT){$('main').style.transform='';mT=0}
  const dp=Math.min(1,Math.max(0,(now-DEF.start)/(DEF.end-DEF.start)));T($('fLeft'),'Уже прошло '+fmt(Math.floor(dp*FD),0)+' из '+fmt(FD,0)+' дн ('+fmt(dp*100,2)+' %)');
  DEC.forEach(([e,t])=>e.classList.toggle('gone',left/1000<=t));
  if($('games').classList.contains('gone'))closeG();
  lastLeft=left;if(left<=3e5&&ADV)advSet(0);
  const p=left>0?parts(now,new Date(DEF.end)):[0,0,0,0,0,0,0];
  p.forEach((v,i)=>{if(ap)v=rnd.p[i];bigEls[i].children[0].textContent=i>=3?String(v).padStart(i==6?3:2,'0'):v;bigEls[i].children[1].textContent=ap?lab[i]:pl(v,U[i])});
  const S=DEF.start,span=DEF.end-S,pr=ap?rnd.pct:(span>0?Math.min(1,Math.max(0,(now-S)/span)):1)*100;
  $('fill').style.width=pr+'%';$('pct').textContent=fmt(pr,6)+' %';$('mS').textContent=ds(S);$('mE').textContent=ds(DEF.end);if(ADV)advFrame();
  DV.forEach((dv,i)=>{const v=left/dv,dec=i<2?4:i==2?2:0;totEls[i].children[0].textContent=ap?rnd.t[i]:fmt(dec?v:Math.floor(v),dec);totEls[i].children[1].textContent=(ap?lab[i]:pl(Math.floor(v),U[i]))+' всего'});
 }catch(e){console.error(e)}
 requestAnimationFrame(tick)}
const dateSet=()=>{const v=$('dt').value,t=v?new Date(v).getTime():NaN;return isFinite(t)?t:null};
const durSet=()=>{const n=[0,1,2,3,4,5].map(i=>Math.min(1e4,Math.max(0,Math.floor(+$('d'+i).value||0))));if(!n.some(x=>x))return null;
 const t=addM(new Date(DEF.end),-(n[0]*12+n[1])).getTime()-(n[2]*864e5+n[3]*36e5+n[4]*6e4+n[5]*1e3);return isFinite(t)?t:null};
const apply=t=>{if(t==null){$('err').textContent='Заполните значение';return}$('err').textContent='';cfg.off=t-Date.now();save()};
const NM={april:'🤡 1 апреля',bday:'🎂 День рождения',anniv:'🥂 Годовщина',halloween:'🎃 Хэллоуин',black:'🏷️ Чёрная пятница',winter:'❄️ Новый год',fri13:'🕸️ Пятница 13',vice:'🌴 Vice City',doom:'2031.'};
const OCC=(()=>{const o={},lim=DEF.end-60000,add=(k,d)=>{const t=+d;if(t>=DEF.start&&t<(k==='doom'?lim:+new Date(2031,0,1)))(o[k]=o[k]||[]).push(t)};
 for(let y=2026;y<=2031;y++){add('winter',new Date(y,11,1));add('halloween',new Date(y,9,25));add('bday',new Date(y,3,28));add('april',new Date(y,3,1));add('anniv',new Date(y,7,15));add('black',new Date(y,10,1+(4-new Date(y,10,1).getDay()+7)%7+22))}
 for(let d=new Date(DEF.start);d<lim;d.setDate(d.getDate()+1))if(d.getDate()==13&&d.getDay()==5)add('fri13',new Date(d));
 add('vice',new Date(2026,10,19));add('doom',new Date(2031,0,1));
 o.blood=[lim];o.end=[DEF.end+60000];return o})();
