body[data-theme=halloween] .facts{box-shadow:0 0 20px rgba(255,122,24,.3)}
body[data-theme=bday] .facts{border:2px dashed #ff7eb6}
body[data-theme=anniv] .facts{border-color:rgba(255,215,120,.6);box-shadow:0 0 22px rgba(255,200,80,.25)}
body[data-theme=fri13] .facts{border-color:#3f6660;box-shadow:0 0 16px rgba(127,209,185,.25)}
body[data-theme=black] .facts{border:2px solid #ffd400}
